# Crate-root .dockerignore.
#
# NOTE: the Docker build context for brain-edge is the arc-labs PARENT dir
# (see Dockerfile header + docker-compose.yml `context: ..`), so THIS file is
# not the one Docker consults during the compose build — the parent
# /Users/dodo/Desktop/work/arc-labs/.dockerignore governs that. This file is
# kept for anyone building with brain-edge/ as the context directly.
target/
.git/
.gitignore
*.md
Dockerfile
.dockerignore
docker-compose.yml
**/*.DS_Store
