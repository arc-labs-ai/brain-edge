# Crate-root .dockerignore.
#
# The build context is this crate, so this is the file Docker consults. It was
# not, while Cargo.toml carried a path dep on a sibling checkout and the context
# had to be the parent directory; brain-db-sdk is on crates.io now.
target/
.git/
.gitignore
*.md
Dockerfile
.dockerignore
docker-compose.yml
**/*.DS_Store
